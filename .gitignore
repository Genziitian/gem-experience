.DS_Store
*.log

# Duplicate of assets/design/project/ — old Claude Design zip extract at repo root
# extracted both a flattened and a nested copy. The bundle copy is the one kept.
/project/

# Admin / env
admin/node_modules/
admin/dist/
# built at deploy time by vercel.json's buildCommand
frontend/admin/
admin/.env
.env
.env.local

# Photography masters and supplier paperwork (~1.2GB): 3000px originals, PDFs,
# spreadsheets and video. The web-sized WebP derivatives under
# frontend/fine-jewellery/img/ are what ships; these stay local.
/Fine jewellery/**/*.jpg
/Fine jewellery/**/*.jpeg
/Fine jewellery/**/*.png
/Fine jewellery/**/*.mp4
/Fine jewellery/**/*.pdf
/Fine jewellery/**/*.xlsx
/Fine jewellery/**/*.docx

# Same again for the High Jewellery shoot (~2.0GB): 1440px stills and 5464x8192
# model frames, plus the write-up documents. The 9MB of WebP derivatives under
# frontend/high-jewellery/img/pieces/ are what ships; these stay local.
/High Jewellery  3/**/*.jpg
/High Jewellery  3/**/*.jpeg
/High Jewellery  3/**/*.png
/High Jewellery  3/**/*.mp4
/High Jewellery  3/**/*.pdf
/High Jewellery  3/**/*.xlsx
/High Jewellery  3/**/*.docx
