  "mailer_subjects_confirmation": "Confirm your email | Gem Experience",
  "mailer_templates_confirmation_content": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"color-scheme\" content=\"light only\">\n<title>Confirm your email</title>\n<link href=\"https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=Jost:wght@300;400;500&display=swap\" rel=\"stylesheet\">\n</head>\n<body style=\"margin:0;padding:0;background:#f5f1e8\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0;color:transparent\">One step to open your Gem Experience account.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse:collapse;background:#f5f1e8\">\n<tr><td align=\"center\" style=\"padding:32px 12px\">\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse:collapse;max-width:600px;background:#ffffff\">\n    <tr><td align=\"center\" style=\"padding:36px 32px 28px;border-bottom:1px solid #e3ddd0\">\n      <a href=\"https://gem-experience.com/\" style=\"font:500 13px/1 Jost, 'Helvetica Neue', Helvetica, Arial, sans-serif;letter-spacing:7px;text-transform:uppercase;color:#17140f;text-decoration:none\">Gem Experience</a>\n    </td></tr>\n    <tr><td style=\"padding:44px 40px 40px\">\n      <div style=\"font:500 10px/16px Jost, 'Helvetica Neue', Helvetica, Arial, sans-serif;letter-spacing:3.6px;text-transform:uppercase;color:#6b6259\">Client account</div>\n      <h1 style=\"margin:14px 0 22px;font:400 32px/1.15 'EB Garamond', Garamond, Georgia, 'Times New Roman', serif;color:#17140f\">Confirm your email</h1>\n      <p style=\"margin:0 0 16px;font:300 15px/25px Jost, 'Helvetica Neue', Helvetica, Arial, sans-serif;color:#2b2620\">Thank you for creating an account. Confirm this address to follow your orders, quotations and appointments in one place.</p><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse:collapse;margin:32px 0 0\">\n  <tr><td style=\"background:#17140f\">\n    <a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:16px 30px;font:500 11px/1 Jost, 'Helvetica Neue', Helvetica, Arial, sans-serif;letter-spacing:3px;text-transform:uppercase;color:#ffffff;text-decoration:none\">Confirm my email</a>\n  </td></tr>\n</table><p style=\"margin:0 0 16px;font:300 15px/25px Jost, 'Helvetica Neue', Helvetica, Arial, sans-serif;color:#2b2620\"><span style=\"font-size:13px\">Please open the link in the browser where you created the account.</span></p>\n      <p style=\"margin:32px 0 0;padding-top:20px;border-top:1px solid #e3ddd0;font:300 12px/19px Jost, 'Helvetica Neue', Helvetica, Arial, sans-serif;color:#6b6259\">If you did not ask for this, you can ignore this email; nothing changes on your account. Questions? Reply to this email or write to contact@gem-experience.com.</p>\n    </td></tr>\n    <tr><td align=\"center\" style=\"background:#2b2620;padding:36px 32px\">\n      <div style=\"font:500 12px/1 Jost, 'Helvetica Neue', Helvetica, Arial, sans-serif;letter-spacing:6px;text-transform:uppercase;color:#ffffff\">Gem Experience</div>\n      <div style=\"margin:14px 0 0;font:italic 400 16px/24px 'EB Garamond', Garamond, Georgia, 'Times New Roman', serif;color:#e9e3d6\">Singular pieces, each cut from a stone<br>we followed out of the ground.</div>\n      <div style=\"margin:22px 0 0;font:300 12px/20px Jost, 'Helvetica Neue', Helvetica, Arial, sans-serif;color:#e9e3d6\">\n        Dubai · Jaipur · Arusha<br>\n        <a href=\"mailto:contact@gem-experience.com\" style=\"color:#e9e3d6\">contact@gem-experience.com</a> · <a href=\"https://wa.me/971567203896\" style=\"color:#e9e3d6\">WhatsApp +971 56 720 3896</a>\n      </div>\n      <div style=\"margin:18px 0 0;font:500 10px/16px Jost, 'Helvetica Neue', Helvetica, Arial, sans-serif;letter-spacing:2.4px;text-transform:uppercase\">\n        <a href=\"https://gem-experience.com/high-jewellery/\" style=\"color:#ffffff;text-decoration:none\">High Jewellery</a>&nbsp;&nbsp;·&nbsp;&nbsp;<a href=\"https://gem-experience.com/fine-jewellery/\" style=\"color:#ffffff;text-decoration:none\">Fine Jewellery</a>&nbsp;&nbsp;·&nbsp;&nbsp;<a href=\"https://gem-experience.com/appointment/\" style=\"color:#ffffff;text-decoration:none\">Book a viewing</a>\n      </div>\n    </td></tr>\n  </table>\n</td></tr>\n</table>\n</body>\n</html>",
  "mailer_subjects_magic_link": "{{ .Token }} is your Gem Experience sign-in code",
