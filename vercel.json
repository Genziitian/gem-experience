{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "frontend",
  "buildCommand": "npm install --prefix admin && npm run build --prefix admin",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/index.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/post/index.html"
    },
    {
      "source": "/blog/:slug/",
      "destination": "/blog/post/index.html"
    }
  ],
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/celestine",
      "destination": "/high-jewellery/celestine/",
      "permanent": false
    },
    {
      "source": "/celestine/",
      "destination": "/high-jewellery/celestine/",
      "permanent": false
    }
  ]
}
